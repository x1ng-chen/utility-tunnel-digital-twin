FROM python:3.12-slim
WORKDIR /app/backend
COPY backend/requirements.lock ./requirements.lock
RUN pip install --no-cache-dir --require-hashes -r requirements.lock
ARG INSTALL_RAG=0
COPY deploy/agent-demo/requirements-rag.txt /tmp/requirements-rag.txt
RUN if [ "$INSTALL_RAG" = "1" ]; then pip install --no-cache-dir torch==2.14.1 --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir -r /tmp/requirements-rag.txt; fi
COPY backend /app/backend
COPY docs /app/docs
COPY model /app/model
COPY frontend/public/models/utility-tunnel-v24.glb /app/frontend/public/models/utility-tunnel-v24.glb
COPY firmware/four-controller/FIX-VALIDATION-20261027.md /app/firmware/four-controller/FIX-VALIDATION-20261027.md
ENV DJANGO_ENV=development DJANGO_SETTINGS_MODULE=config.agent_demo_settings PYTHONUNBUFFERED=1
CMD ["python","manage.py","runserver","0.0.0.0:18927","--noreload"]
