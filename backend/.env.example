DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Leave empty for local SQLite. Set for PostgreSQL deployments.
DATABASE_URL=postgresql://ut_app:change-me@127.0.0.1:5432/utility_tunnel
DJANGO_ENV=development
API_TOKEN_TTL_SECONDS=900
LOGIN_RATE_LIMIT=10/min
CORS_ALLOW_CREDENTIALS=false
# Production only: set DJANGO_SECURE_SSL_REDIRECT=true and DJANGO_ENABLE_HSTS=true behind HTTPS.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_ENABLE_HSTS=false
DJANGO_TRUST_PROXY_SSL=false
DJANGO_TRUST_PROXY_HEADERS=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
