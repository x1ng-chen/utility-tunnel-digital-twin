DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Leave empty for local SQLite. Set for PostgreSQL deployments.
DATABASE_URL=postgresql://ut_app:change-me@127.0.0.1:5432/utility_tunnel?sslmode=require
DJANGO_ENV=development
APP_VERSION=0.6.0
APP_COMMIT_SHA=local
# Local controller-command broker. Keep credentials only in the untracked .env.
MQTT_COMMAND_BROKER_HOST=127.0.0.1
MQTT_COMMAND_BROKER_PORT=1884
MQTT_COMMAND_USERNAME=
MQTT_COMMAND_PASSWORD=
MQTT_COMMAND_ACK_TIMEOUT_SECONDS=3
API_TOKEN_TTL_SECONDS=900
# Optional machine-only telemetry identity. Generate at least 32 random bytes,
# store it in the deployment secret manager, and provision the principal with
# `python manage.py configure_ingest_principal`.
DJANGO_INGEST_API_KEY=
DJANGO_INGEST_PRINCIPAL_USERNAME=service-iotda-ingest
REGISTRATION_SETUP_TTL_SECONDS=86400
DEVICE_OFFLINE_GRACE_MULTIPLIER=3
DEVICE_OFFLINE_MIN_GRACE_SECONDS=15
LOGIN_RATE_LIMIT=10/min
REGISTRATION_RATE_LIMIT=5/hour
PASSWORD_SETUP_RATE_LIMIT=10/min
LOGIN_BURST_RATE_LIMIT=60/min
PASSWORD_CHANGE_RATE_LIMIT=5/hour
CORS_ALLOW_CREDENTIALS=false
# Production only: set these to true when Nginx terminates HTTPS and forwards to Django.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_ENABLE_HSTS=false
DJANGO_TRUST_PROXY_SSL=false
DJANGO_TRUST_PROXY_HEADERS=false
TWIN_MODEL_MAX_BYTES=33554432
# Must be greater than or equal to TWIN_MODEL_MAX_BYTES for multipart uploads.
DJANGO_MAX_REQUEST_BYTES=34603008
DJANGO_MAX_REQUEST_FIELDS=1000
# Development uses the dependency-free in-process cache. Production must
# override this with a shared backend (DatabaseCache is built into Django).
DJANGO_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
DJANGO_CACHE_LOCATION=utility_tunnel_cache
SEED_ADMIN_EMAIL=admin
SEED_ADMIN_PASSWORD=local-admin-password-2026
