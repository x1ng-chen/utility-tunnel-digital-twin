LOCAL_MQTT_URL=mqtt://127.0.0.1:1884
# LOCAL_MQTT_USERNAME=
# LOCAL_MQTT_PASSWORD=
LOCAL_DEVICE_ID=CTRL-01

# ESP8266 broker auto-discovery. The advertised port is the Windows host port
# (Docker maps it to the Mosquitto container's internal listener).
MQTT_DISCOVERY_ENABLED=true
MQTT_DISCOVERY_PORT=4210
MQTT_DISCOVERY_INTERVAL_MS=3000
MQTT_DISCOVERY_TARGETS=10.106.76.200,10.106.76.1
MQTT_PUBLIC_PORT=1884
# Must exactly match DISCOVERY_HMAC_KEY in ESP secrets.h. Generate a unique
# random value for each deployment; never commit the real value.
MQTT_DISCOVERY_HMAC_KEY=replace-with-at-least-16-random-characters

# Set to false to run the gateway with the Django lane only (bench demo mode).
# IOTDA_ENABLED=true
# Copy the device access domain from IoTDA Console > Overview > Access Details.
IOTDA_HOST=replace-me.iotda-device.cn-north-4.myhuaweicloud.com
IOTDA_PORT=8883
IOTDA_DEVICE_ID=replace-with-platform-device-id
IOTDA_DEVICE_SECRET=replace-with-device-secret
# Optional PEM CA bundle. When omitted, Node.js uses its trusted public CAs.
# IOTDA_CA_FILE=C:\secure\DigiCertGlobalRootCA.crt

# Second output lane: forward validated telemetry to the Django ingest API
# (POST /api/telemetry/) using a machine-only API key. Leave
# DJANGO_API_URL empty to run the cloud-only lane exactly as before.
# DJANGO_API_URL=http://127.0.0.1:8000
# DJANGO_INGEST_API_KEY=replace-with-at-least-32-random-characters
# Legacy migration fallback only; remove after API-key rollout:
# DJANGO_INGEST_EMAIL=gateway@example.com
# DJANGO_INGEST_PASSWORD=replace-with-service-account-password
# Request timeout in milliseconds (500-60000).
# DJANGO_TIMEOUT_MS=5000
# Maximum queued batches; 43200 covers roughly 24 hours at one frame/2 seconds.
# DJANGO_QUEUE_MAX=43200
# Maximum transient failures for one batch before it moves to dead letter.
# DJANGO_MAX_ITEM_RETRIES=8
# Durable SQLite/WAL outbox. Keep this path on persistent local storage.
# DJANGO_QUEUE_DB=./data/iotda-outbox.sqlite
