# Load these into the voice-server process environment. This file is not auto-loaded.
# Public URL only; /api is required. Remote deployments must use HTTPS.
UT_VOICE_API_URL=http://127.0.0.1:8000/api
# Dedicated viewer bearer token, never an administrator password or ingest key.
# Existing Django tokens expire after 900 seconds by default; development use only.
UT_VOICE_API_TOKEN=

# Optional explicit local-development mode: viewer credentials stay in this private file.
# This mode renews 900-second viewer sessions; remove UT_VOICE_API_TOKEN from the process.
UT_VOICE_VIEWER_CREDENTIALS_FILE=D:\ut-voice\private\viewer-credentials.json
