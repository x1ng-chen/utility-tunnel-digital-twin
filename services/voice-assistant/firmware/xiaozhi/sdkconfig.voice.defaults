# User-specific fragment for the pinned firmware, not a standalone sdkconfig.
CONFIG_BOARD_TYPE_UTILITY_TUNNEL_S3=y
CONFIG_UTILITY_TUNNEL_OFFLINE_WAKE_TEST=y
CONFIG_UTILITY_TUNNEL_SPEAKER_TEST=y
CONFIG_UTILITY_TUNNEL_SPEAKER_TEST_VOLUME=40
CONFIG_LANGUAGE_ZH_CN=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_FLASH_DEFAULT_ASSETS=y

CONFIG_USE_CUSTOM_WAKE_WORD=y
CONFIG_CUSTOM_WAKE_WORD="ni hao xiao guan"
CONFIG_CUSTOM_WAKE_WORD_DISPLAY="你好，小管"
CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
CONFIG_SR_MN_EN_NONE=y

# No playback-reference wiring has been validated on this board.
CONFIG_USE_DEVICE_AEC=n
CONFIG_USE_SERVER_AEC=n
CONFIG_SEND_WAKE_WORD_DATA=n
CONFIG_WAKE_WORD_DETECTION_IN_LISTENING=n
CONFIG_USE_AUDIO_DEBUGGER=n

# Replace with the authenticated self-hosted OTA/device endpoint before use.
# Deliberately do not inherit the upstream public service URL.
CONFIG_OTA_URL="https://voice-endpoint.invalid/xiaozhi/ota/"
