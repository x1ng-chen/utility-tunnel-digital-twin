+#if CONFIG_BOARD_TYPE_UTILITY_TUNNEL_S3
+bool Application::PlayUtilityTunnelWakeAcknowledgement() {
+    audio_service_.EnableVoiceProcessing(false);
+    audio_service_.EnableWakeWordDetection(false);
+    while (audio_service_.PopPacketFromSendQueue()) {}
+    xEventGroupClearBits(event_group_, MAIN_EVENT_WAKE_WORD_DETECTED | MAIN_EVENT_SEND_AUDIO);
+    if (!audio_service_.IsPlaybackIdle()) {
+        ESP_LOGW(TAG, "VOICE NETWORK ACK: audio busy");
+        return false;
+    }
+    auto& board = Board::GetInstance();
+    auto* codec = board.GetAudioCodec();
+    auto* display = board.GetDisplay();
+    display->SetStatus("唤醒成功");
+    display->SetChatMessage("assistant", "我在呀，你说！");
+    ESP_LOGI(TAG, "VOICE NETWORK ACK: start, volume=%d", codec->output_volume());
+    audio_service_.PlaySound(UtilityTunnelVoice::WakeAcknowledgement());
+    const int64_t deadline = esp_timer_get_time() + 5LL * 1000 * 1000;
+    while (!audio_service_.IsPlaybackIdle() && esp_timer_get_time() < deadline) {
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
+    if (!audio_service_.IsPlaybackIdle()) {
+        audio_service_.ResetDecoder();
+        ESP_LOGE(TAG, "VOICE NETWORK ACK: playback timeout");
+        return false;
+    }
+    // Current board DMA covers about 30ms of TX and 90ms of RX. Keep a
+    // bounded tail for playback echo without adding a 300ms capture blind spot.
+    constexpr int kWakeEchoTailMs = 150;
+    ESP_LOGI(TAG, "VOICE NETWORK ACK: playback drained; echo tail=%dms", kWakeEchoTailMs);
+    vTaskDelay(pdMS_TO_TICKS(kWakeEchoTailMs));
+    codec->EnableOutput(false);
+    while (audio_service_.PopPacketFromSendQueue()) {}
+    xEventGroupClearBits(event_group_, MAIN_EVENT_WAKE_WORD_DETECTED | MAIN_EVENT_SEND_AUDIO);
+    if (GetDeviceState() != kDeviceStateConnecting || !protocol_ ||
+        !protocol_->IsAudioChannelOpened()) {
+        ESP_LOGW(TAG, "VOICE NETWORK ACK: channel closed before listening");
+        return false;
+    }
+    ESP_LOGI(TAG, "VOICE NETWORK ACK: drained; start listening");
+    return true;
+}
+#endif
 
