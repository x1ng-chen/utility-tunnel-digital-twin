+#if CONFIG_BOARD_TYPE_UTILITY_TUNNEL_S3
+void Application::StopUtilityTunnelSpeech(const std::string& command) {
+    const auto state = GetDeviceState();
+    if ((state != kDeviceStateSpeaking && state != kDeviceStateListening) ||
+        utility_stop_ack_in_progress_.exchange(true)) {
+        return;
+    }
+    ESP_LOGI(TAG, "VOICE STOP: detected=%s; cancelling current reply", command.c_str());
+    pending_listening_start_ = false;
+    play_popup_on_listening_ = false;
+    aborted_ = true;
+    audio_service_.EnableVoiceProcessing(false);
+    audio_service_.EnableWakeWordDetection(false);
+    {
+        std::lock_guard<std::mutex> lock(utility_remote_audio_mutex_);
+        utility_remote_audio_enabled_.store(false);
+        ++utility_voice_generation_;
+        audio_service_.ResetDecoder();
+    }
+    while (audio_service_.PopPacketFromSendQueue()) {}
+    xEventGroupClearBits(event_group_, MAIN_EVENT_WAKE_WORD_DETECTED | MAIN_EVENT_SEND_AUDIO);
+    if (protocol_) {
+        if (protocol_->IsAudioChannelOpened()) {
+            protocol_->SendAbortSpeaking(kAbortReasonNone);
+        }
+        protocol_->CloseAudioChannel();
+    }
+    auto& board = Board::GetInstance();
+    auto* codec = board.GetAudioCodec();
+    auto* display = board.GetDisplay();
+    const int64_t old_output_deadline = esp_timer_get_time() + 1000LL * 1000;
+    while (!audio_service_.IsPlaybackIdle() && esp_timer_get_time() < old_output_deadline) {
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
+    codec->EnableOutput(false);
+    if (audio_service_.IsPlaybackIdle()) {
+        display->SetStatus("已停止播报");
+        display->SetChatMessage("assistant", "好的，需要时请随时叫我");
+        ESP_LOGI(TAG, "VOICE STOP ACK: start, volume=%d", codec->output_volume());
+        audio_service_.PlaySound(UtilityTunnelVoice::StopAcknowledgement());
+        const int64_t deadline = esp_timer_get_time() + 7LL * 1000 * 1000;
+        while (!audio_service_.IsPlaybackIdle() && esp_timer_get_time() < deadline) {
+            vTaskDelay(pdMS_TO_TICKS(10));
+        }
+        if (!audio_service_.IsPlaybackIdle()) {
+            audio_service_.ResetDecoder();
+            ESP_LOGE(TAG, "VOICE STOP ACK: playback timeout");
+        }
+        vTaskDelay(pdMS_TO_TICKS(300));
+        codec->EnableOutput(false);
+    } else {
+        ESP_LOGE(TAG, "VOICE STOP ACK: old output did not drain");
+    }
+    while (audio_service_.PopPacketFromSendQueue()) {}
+    xEventGroupClearBits(event_group_, MAIN_EVENT_WAKE_WORD_DETECTED | MAIN_EVENT_SEND_AUDIO |
+                                    MAIN_EVENT_PLAYBACK_DRAINED);
+    ++utility_voice_generation_;
+    utility_stop_ack_in_progress_.store(false);
+    SetDeviceState(kDeviceStateIdle);
+    ESP_LOGI(TAG, "VOICE STOP ACK: complete; return to idle");
+}
