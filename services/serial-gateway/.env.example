# Windows Bluetooth SPP port for JDY-31. On this computer it is COM10.
SERIAL_PORT=COM10
SERIAL_BAUD_RATE=9600

# The local Fastify API device-ingest endpoint.
API_URL=http://127.0.0.1:8080/v1/device/telemetry
DEVICE_ID=CTRL-01

# Must exactly match DEVICE_INGEST_TOKEN in services/api/.env.
DEVICE_INGEST_TOKEN=replace-with-the-same-32-character-minimum-secret
