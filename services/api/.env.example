# Required for API, migrations and seed scripts. Never commit the real value.
DATABASE_URL=postgresql://ut_app:replace-me@your-postgres-host:5432/utility_tunnel?sslmode=require

# Generate a random secret of at least 32 characters for each environment.
JWT_SECRET=replace-with-a-32-character-minimum-secret
PORT=8080
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# Optional MQTT adapter. When configured, the API subscribes to this topic and
# persists device readings before streaming them to authenticated web clients.
# MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TELEMETRY_TOPIC=ut/v1/+/telemetry
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Used only by `npm run seed`; choose a private development password.
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=replace-with-a-private-development-password
